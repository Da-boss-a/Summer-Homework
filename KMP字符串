#include <iostream>

using namespace std;

const int N = 1000010;
char q[N], s[N];
int ne[N];

int main()
{
    int n, m;
    cin >> n >> q + 1 >> m >> s + 1;
    
    for(int i = 2, j = 0; i <= n; i ++ )
    {
        while (j && q[i] != q[j + 1]) j = ne[j];
        if (q[i] == q[j + 1]) j ++ ;
        ne[i] = j;
    }
    for(int i = 1, j = 0; i <= m; i ++ )
    {
        while (j && s[i] != q[j + 1]) j = ne[j];
        if (s[i] == q[j + 1]) j ++ ;
        if(j == n) cout << i - n << " ", j = ne[j];
    }
    return 0;
    
}
