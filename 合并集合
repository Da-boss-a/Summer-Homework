#include <iostream>

using namespace std;

const int N = 100010;
int p[N];

int find(int x)
{
    if (p[x] != x) p[x] = find(p[x]);//路径压缩
    return p[x];
}

int main()
{
    int n, m;
    cin >> n >> m;
    for (int i = 0; i < n; i ++ ) p[i] = i;
    
    for (int i = 0; i < m; i ++ ) 
    {
        string op;
        int a, b;
        cin >> op;
        
        if (op == "M")
        {
        cin >> a >> b;
        p[find(b)] = find(a);
        }
        else 
        {
            cin >> a >> b;
            if (find(a) == find(b)) cout << "Yes" << endl;
            else cout << "No" << endl;
        }
            
    }
}
