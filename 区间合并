#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

typedef pair<int,int> PII;

void merge(vector<PII> &a)
{
    vector<PII> res;
    int st = -2e9, ed = -2e9;
    
    for(int i = 0; i < a.size(); i ++ )
    {
        
        if(ed >= a[i].first) ed = max(ed, a[i].second);
        else 
        {
            if(st != -2e9) res.push_back({st, ed});
            st = a[i].first, ed = a[i].second;
        }
    }
    if (st != -2e9) res.push_back({st, ed});
    
    a = res;
}

int main()
{
    vector<PII> a;
    int n, l, r;
    
    cin >> n;
    for(int i = 0; i < n; i ++ ) 
    {
        cin >> l >> r;
        a.push_back({l, r});
    }
    
    sort(a.begin(), a.end());
    
    merge(a);
    
    cout << a.size();
    return 0;
}
