#include <iostream>

using namespace std;

const int N = 50010;
int q[N], d[N];
int n, k;

int find(int x)
{
    if (q[x] != x)
    {
         int t = find(q[x]);
        d[x] += d[q[x]];//必须先find
        q[x] = t;
    }
    return q[x];
}

int main()
{
    cin >> n >> k;
    
    for(int i = 1; i <= n; i ++ ) q[i] = i;
    int res = 0;
    while (k -- )
    {
        int x, y, op;
        cin >>op >> x >> y;
        
        if (x > n || y > n) res ++ ;
        else 
        {
             int qx = find(x), qy = find(y);
        if (op == 1)
        {
            if(qx == qy && (d[x] - d[y]) % 3) res ++ ;
            else if (qx != qy)
            {
            q[qx] = qy;
            d[qx] = d[y] - d[x];
            }
        }
        else 
        {
            if(qx == qy && (d[x] - d[y] - 1) % 3) res ++ ;
            else if (qx != qy)
            {
            q[qx] = qy;
            d[qx] = d[y] - d[x] + 1;
            }
        }
    }
    }
    cout << res;
    return 0;
}
